# Supabase — Connection string > Transaction pooler
DATABASE_URL="postgresql://usuario:password@host:6543/postgres?pgbouncer=true"
# Supabase — Connection string > Direct connection (migraciones)
DIRECT_URL="postgresql://usuario:password@host:5432/postgres"

PORT=4000
CORS_ORIGIN="http://localhost:3000"

JWT_SECRET="cadena-larga-y-aleatoria"

# Google Cloud Console — API "Books API" habilitada.
# Sin esta key, los requests van contra una cuota anónima compartida que
# suele estar agotada y devuelve 429.
GOOGLE_BOOKS_API_KEY=""

# Google AI Studio — se usa a partir de la fase 4
GEMINI_API_KEY=""
# Opcional — modelo a usar. Por defecto gemini-3.6-flash: la propia API, al
# pedirle un modelo deprecado, recomendó éste para cuentas nuevas. NO usar el
# alias "gemini-flash-latest": hoy apunta a 3.7-flash, que en las pruebas dio
# errores de "alta demanda" y cuelgues con frecuencia.
GEMINI_MODELO="gemini-3.6-flash"
# Opcional — techo diario del contador propio. El límite real de Google en el
# free tier es MUY bajo y varía por modelo: se midió 20 requests para
# gemini-3.6-flash y 5 para gemini-3.7-flash, y además hay un tope diario.
# Verificar el número de la cuenta en https://aistudio.google.com/rate-limit.
# Sirve para cortar con un mensaje propio antes de gastar el request.
GEMINI_LIMITE_DIARIO="20"

# Opcional — desarrollo sin gastar cuota. "usar" responde desde
# fixtures/gemini/*.json sin llamar a la API; "grabar" llama y sobrescribe el
# archivo. Vacío o sin definir: siempre a la API.
GEMINI_FIXTURES=""
