# Supabase — Connection string > Transaction pooler
DATABASE_URL="postgresql://usuario:password@host:6543/postgres?pgbouncer=true"
# Supabase — Connection string > Direct connection (migraciones)
DIRECT_URL="postgresql://usuario:password@host:5432/postgres"

PORT=4000
CORS_ORIGIN="http://localhost:3000"

JWT_SECRET="cadena-larga-y-aleatoria"

# Google Cloud Console — API "Books API" habilitada.
# Sin esta key, los requests van contra una cuota anónima compartida que
# suele estar agotada y devuelve 429.
GOOGLE_BOOKS_API_KEY=""

# Google AI Studio — se usa a partir de la fase 4
GEMINI_API_KEY=""
# Opcionales: modelo y techo diario de llamadas antes de degradar las
# funciones con IA (el free tier limita por requests por día, no por gasto).
GEMINI_MODELO="gemini-flash-latest"
GEMINI_LIMITE_DIARIO="180"
