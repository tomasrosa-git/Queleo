generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  passwordHash String
  name         String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  refreshTokens RefreshToken[]
  biblioteca   EntradaBiblioteca[]
  perfil       PerfilLector?
  mensajes     MensajeOnboarding[]
  recomendaciones Recomendacion[]
  analisis     AnalisisLibro[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Libro {
  id              String   @id @default(uuid())
  googleBooksId   String   @unique
  titulo          String
  autores         String[]
  isbn            String?
  portadaUrl      String?
  anioPublicacion Int?
  paginas         Int?
  ratingPublico   Float?
  cantidadRatings Int?
  cacheadoEn      DateTime @default(now())
  entradas        EntradaBiblioteca[]
  recomendaciones Recomendacion[]
  analisis        AnalisisLibro[]
}

enum EstadoLectura {
  QUIERO_LEER
  LEYENDO
  LEIDO
}

model EntradaBiblioteca {
  id            String        @id @default(uuid())
  usuario       User          @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId     String
  libro         Libro         @relation(fields: [libroId], references: [id], onDelete: Cascade)
  libroId       String
  estado        EstadoLectura
  rating        Int?
  resena        String?
  creadaEn      DateTime      @default(now())
  actualizadaEn DateTime      @updatedAt

  @@unique([usuarioId, libroId])
  @@index([usuarioId, estado])
}

model PerfilLector {
  id            String   @id @default(uuid())
  usuario       User     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId     String   @unique
  resumen       String
  generos       String[]
  autores       String[]
  patrones      String[]
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt
}

enum RolMensaje {
  USUARIO
  ASISTENTE
}

model MensajeOnboarding {
  id        String     @id @default(uuid())
  usuario   User       @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId String
  rol       RolMensaje
  contenido String
  creadoEn  DateTime   @default(now())

  @@index([usuarioId, creadoEn])
}

// El free tier de Gemini limita por requests diarios, no por gasto: el techo
// se controla con un contador global del día, no por usuario.
model ConsumoGemini {
  fecha    String @id
  llamados Int    @default(0)
}

model Recomendacion {
  id           String   @id @default(uuid())
  usuario      User     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId    String
  libro        Libro    @relation(fields: [libroId], references: [id], onDelete: Cascade)
  libroId      String
  razonamiento String
  reparo       String?
  orden        Int
  creadaEn     DateTime @default(now())
  // Se marca en vez de borrarse: si desapareciera, la próxima tanda no
  // sabría que ese libro ya se propuso y podría volver a sugerirlo.
  descartadaEn DateTime?

  @@unique([usuarioId, libroId])
  @@index([usuarioId, orden])
}

// La predicción se guarda para no volver a pagarle a la IA cada vez que se
// abre la misma ficha; se puede regenerar a pedido.
model AnalisisLibro {
  id           String   @id @default(uuid())
  usuario      User     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId    String
  libro        Libro    @relation(fields: [libroId], references: [id], onDelete: Cascade)
  libroId      String
  sinopsis     String
  prediccion   Float
  razonamiento String
  creadoEn     DateTime @default(now())

  @@unique([usuarioId, libroId])
}
