generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  passwordHash String
  name         String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  refreshTokens RefreshToken[]
  biblioteca   EntradaBiblioteca[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Libro {
  id              String   @id @default(uuid())
  googleBooksId   String   @unique
  titulo          String
  autores         String[]
  isbn            String?
  portadaUrl      String?
  anioPublicacion Int?
  paginas         Int?
  cacheadoEn      DateTime @default(now())
  entradas        EntradaBiblioteca[]
}

enum EstadoLectura {
  QUIERO_LEER
  LEYENDO
  LEIDO
}

model EntradaBiblioteca {
  id            String        @id @default(uuid())
  usuario       User          @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId     String
  libro         Libro         @relation(fields: [libroId], references: [id], onDelete: Cascade)
  libroId       String
  estado        EstadoLectura
  rating        Int?
  resena        String?
  creadaEn      DateTime      @default(now())
  actualizadaEn DateTime      @updatedAt

  @@unique([usuarioId, libroId])
  @@index([usuarioId, estado])
}
